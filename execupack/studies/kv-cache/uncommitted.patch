+    examples/models/gemma3/config/1b_config.json spells Gemma 3 1B, from the checkpoint's config.
+
+    Only what the 1B needs is validated: no RoPE scaling (the 4B and larger scale their global
+    layers' RoPE), no soft-capping, the query scaled by 1/sqrt(head_dim). The sliding window
+    becomes ring caches through export_llm's local_global_attention, and the prefill chunk is the
+    window, the most a ring takes per update (pipeline/gemma3_model.py).
+    """
+    _require(c.get("model_type") in ("gemma3_text", "gemma3"), f"model_type {c.get('model_type')!r}")
+    _require(c.get("hidden_activation", "gelu_pytorch_tanh") == "gelu_pytorch_tanh", "Gemma 3 activation")
+    _require(rope_scaling(c) is None and not c.get("rope_scaling"), "Gemma 3 with RoPE scaling is not validated")
+    _require(c.get("attn_logit_softcapping") is None, "attention logit soft-capping is not implemented")
+    _require(c.get("final_logit_softcapping") is None, "final logit soft-capping is not implemented")
+    _require(not c.get("attention_bias"), "Gemma 3 with attention biases is not supported")
+    _require(bool(c.get("tie_word_embeddings", True)), "Gemma 3 with untied embeddings is not validated")
+    head_dim = int(c["head_dim"])
+    _require(int(c.get("query_pre_attn_scalar") or head_dim) == head_dim, "query_pre_attn_scalar != head_dim")
+    window = int(c.get("sliding_window") or 0)
+    _require(window > 0, "Gemma 3 config names no sliding_window")
+    layer_types = gemma3_layer_types(c)
+    _require(len(layer_types) == int(c["num_hidden_layers"]), "layer_types does not match num_hidden_layers")
+    _require(set(layer_types) <= {"sliding_attention", "full_attention"}, f"layer types {sorted(set(layer_types))}")
+    n_heads = int(c["num_attention_heads"])
+    params = {
+        "dim": int(c["hidden_size"]),
+        "ffn_dim_multiplier": 1,
+        "hidden_dim": int(c["intermediate_size"]),
+        "n_heads": n_heads,
+        "head_dim": head_dim,
+        "n_kv_heads": int(c.get("num_key_value_heads") or n_heads),
+        "n_layers": int(c["num_hidden_layers"]),
+        "norm_eps": float(c["rms_norm_eps"]),
+        "rope_theta": _gemma3_global_theta(c),
+        "local_rope_theta": _gemma3_local_theta(c),
+        "vocab_size": int(c["vocab_size"]),
+        "use_scaled_rope": False,
+        "use_hf_rope": True,
+        "attention_qkv_bias": False,
+        "use_qk_norm": True,
+        "qk_norm_before_rope": True,
+        "rms_norm_add_unit_offset": True,
+        "act_fn": "gelu_approx",
+        "post_attention_norm": True,
