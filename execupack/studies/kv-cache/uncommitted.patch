+def gemma3_layer_types(c: dict) -> list[str]:
+    """Gemma 3's per-layer attention, from ``layer_types`` or (transformers v4 configs, as
+    google/gemma-3-1b-it ships) ``sliding_window_pattern``: every period-th layer is global."""
+    layer_types = c.get("layer_types")
+    if layer_types:
+        return list(layer_types)
+    period = int(c.get("sliding_window_pattern") or 0)
+    _require(period > 0, "Gemma 3 config names neither layer_types nor sliding_window_pattern")
+    return [
+        "full_attention" if (i + 1) % period == 0 else "sliding_attention" for i in range(int(c["num_hidden_layers"]))
+    ]
+
+
+def _gemma3_local_theta(c: dict) -> float:
+    if c.get("rope_local_base_freq") is not None:
+        return float(c["rope_local_base_freq"])
+    rope = (c.get("rope_parameters") or {}).get("sliding_attention") or {}
+    _require("rope_theta" in rope, "Gemma 3 config names no local RoPE theta")
+    return float(rope["rope_theta"])
+
+
+def _gemma3_global_theta(c: dict) -> float:
+    if c.get("rope_theta") is not None:
+        return float(c["rope_theta"])
+    rope = (c.get("rope_parameters") or {}).get("full_attention") or {}
+    _require("rope_theta" in rope, "Gemma 3 config names no global RoPE theta")
+    return float(rope["rope_theta"])
+
+
