+def replace_weights(source_dir: Path, weight_dir: Path) -> dict:
+    """Put a transformed checkpoint (scripts/mtk_gptq.py: GPTQ onto A16W4's grid) in place of the
+    downloaded weights, for an experiment (MTK_WEIGHTS_FROM). The tokenizer, licenses and config
+    stay the source's; the config takes only the keys the transform changed (config_overrides.json:
+    an untied head). The report records the checkpoint's digest and the transform's own log."""
+    files = sorted(source_dir.glob("*.safetensors"))
+    if not files:
+        raise ExportError(f"MTK_WEIGHTS_FROM={source_dir} holds no .safetensors")
+    for old in list(weight_dir.glob("*.safetensors")) + list(weight_dir.glob("*.safetensors.index.json")):
+        old.unlink()
+    for f in files:
+        shutil.copy2(f, weight_dir / f.name)
+    overrides_file = source_dir / "config_overrides.json"
+    overrides = json.loads(overrides_file.read_text(encoding="utf-8")) if overrides_file.exists() else {}
+    if overrides:
+        config_path = weight_dir / "config.json"
+        config = json.loads(config_path.read_text(encoding="utf-8"))
+        config.update(overrides)
+        config_path.write_text(json.dumps(config, indent=2), encoding="utf-8")
+    log_file = source_dir / "gptq.json"
+    log = json.loads(log_file.read_text(encoding="utf-8")) if log_file.exists() else {}
+    return {
+        "from": str(source_dir),
+        "files": {f.name: sha256(f) for f in files},
+        "config_overrides": overrides,
+        "transform": {k: log[k] for k in ("rows", "tokens", "seconds", "head", "mismatched") if k in log},
+    }
+
+
