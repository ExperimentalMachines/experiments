+def test_replace_weights_swaps_the_checkpoint_and_only_the_overridden_config_keys(tmp_path):
+    weights = tmp_path / "weights"
+    weights.mkdir()
+    (weights / "model-00001-of-00002.safetensors").write_bytes(b"original 1")
+    (weights / "model-00002-of-00002.safetensors").write_bytes(b"original 2")
+    (weights / "model.safetensors.index.json").write_text("{}")
+    (weights / "tokenizer.json").write_text("tokenizer")
+    (weights / "config.json").write_text(json.dumps({"model_type": "qwen3", "tie_word_embeddings": True}))
+    solved = tmp_path / "gptq"
+    solved.mkdir()
+    (solved / "model.safetensors").write_bytes(b"solved")
+    (solved / "config.json").write_text(json.dumps({"model_type": "something else"}))
+    (solved / "config_overrides.json").write_text(json.dumps({"tie_word_embeddings": False}))
+    (solved / "gptq.json").write_text(
+        json.dumps(
+            {
+                "rows": 104,
+                "tokens": 9000,
+                "seconds": 600,
+                "head": True,
+                "mismatched": 0,
+                "linears": {"layers.0.q_proj": {}},
+            }
+        )
+    )
+
+    override = export_mtk.replace_weights(solved, weights)
+
+    assert sorted(p.name for p in weights.iterdir()) == ["config.json", "model.safetensors", "tokenizer.json"]
+    assert (weights / "model.safetensors").read_bytes() == b"solved"
+    # The source's config stays, with only the key the solve changed (an untied head).
+    assert json.loads((weights / "config.json").read_text()) == {"model_type": "qwen3", "tie_word_embeddings": False}
+    assert override["config_overrides"] == {"tie_word_embeddings": False}
+    assert override["transform"] == {"rows": 104, "tokens": 9000, "seconds": 600, "head": True, "mismatched": 0}
+    assert set(override["files"]) == {"model.safetensors"}
+
+
