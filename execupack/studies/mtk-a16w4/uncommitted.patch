+def test_the_tool_python_keeps_its_venv_path_rather_than_the_interpreter_it_links_to(tmp_path, monkeypatch):
+    # A virtualenv's bin/python is a symlink to the base interpreter, and Python finds the venv
+    # (pyvenv.cfg, site-packages) from the path it was started by. Resolving the link ran
+    # MediaTek's tools on the bare interpreter, without mtk_converter (RunPod, 2026-11-19).
+    base = tmp_path / "base" / "python3.10"
+    base.parent.mkdir()
+    base.write_text("")
+    venv_python = tmp_path / "venv" / "bin" / "python"
+    venv_python.parent.mkdir(parents=True)
+    venv_python.symlink_to(base)
+    monkeypatch.chdir(tmp_path)
+    assert export_mtk.absolute_tool("venv/bin/python") == str(venv_python)
+    assert export_mtk.absolute_tool(str(venv_python)) == str(venv_python)
+
