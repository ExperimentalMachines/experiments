+def _find_pte(out: Path, work: Path, result: dict) -> Path:
+    """The file an arm measured: one built elsewhere (an absolute published path), the published one it downloaded,
+    or its own export (kept with --keep-pte)."""
+    published = result.get("published")
+    if published and published.startswith("/"):
+        return Path(published)
+    found = sorted((work / "published").rglob("*.pte")) if published else sorted((out / "export").rglob("*.pte"))
+    if not found:
+        raise SystemExit(f"no .pte for {out}: was the arm run with --keep-pte?")
+    return found[0]
+
+
+def _stops(tokenizer) -> set[int]:
+    """The tokens that end a reply: the tokenizer's end of sequence and each chat format's end of turn."""
+    ids = {tokenizer.eos_token_id} if tokenizer.eos_token_id is not None else set()
+    for t in ("<|im_end|>", "<|eot_id|>", "<|end_of_text|>", "<|endoftext|>"):
+        i = tokenizer.convert_tokens_to_ids(t)
+        if isinstance(i, int) and i != tokenizer.unk_token_id and i >= 0:
+            ids.add(i)
+    return ids
+
+
+def _lcs(a: list[int], b: list[int]) -> int:
+    prev = [0] * (len(b) + 1)
+    for x in a:
+        cur = [0]
+        for j, y in enumerate(b):
+            cur.append(prev[j] + 1 if x == y else max(prev[j + 1], cur[j]))
+        prev = cur
+    return prev[-1]
+
+
+def generate(args) -> int:
+    """Free-running replies. The file writes its own reply to each of the reference's reply prompts, greedily, for as
+    many tokens as the original model's greedy reply (both cut at the first end of turn), and each is set beside the
+    original's: how many tokens match before the first difference, whether the whole reply is the same, and the
+    overlap of the two (ROUGE-L F1 over tokens). Teacher forcing (evaluate) feeds the original's tokens back at every
+    step, so it cannot show errors that compound once a file follows its own text; free generations compared with the
+    original's are how Kurtic et al. ("Give Me BF16 or Give Me Death"?, ACL 2025) check this."""
+    import torch
+    from transformers import AutoTokenizer
+
+    out, work, ref_dir = Path(args.out), Path(args.work), Path(args.ref)
+    result = json.loads((out / f"result-{args.method}.json").read_text(encoding="utf-8"))
+    pte = _find_pte(out, work, result)
+    src_dir = work / "solve" / "source"
+    tokenizer = AutoTokenizer.from_pretrained(str(src_dir))
+    tokenizer_path = src_dir / "tokenizer.json"
+    stops = _stops(tokenizer)
+    evalref = torch.load(ref_dir / "evalref.pt", weights_only=True)
+    scratch = work / "eval"
+    scratch.mkdir(parents=True, exist_ok=True)
+    vocab = len(tokenizer)
+
+    def cut(ids):
+        ids = [int(x) for x in ids]
+        for k, x in enumerate(ids):
+            if x in stops:
+                return ids[: k + 1]
+        return ids
+
+    t = time.time()
+    replies = []
+    for r in evalref["replies"]:
+        want = cut(r["reply"])
+        # A fresh runner per prompt, as evaluate: an LFM2 file carries convolution state.
+        runner = _runner(pte, tokenizer_path, vocab, scratch)
+        prompt = list(r["prompt"])
+        logits = _last(runner.forward(torch.tensor([prompt]), torch.tensor([0])))
+        gen: list[int] = []
+        while len(gen) < len(want):
+            gen.append(int(logits.argmax()))
+            if gen[-1] in stops or len(gen) == len(want):
+                break
+            logits = _last(runner.forward(torch.tensor([[gen[-1]]]), torch.tensor([len(prompt) + len(gen) - 1])))
+        del runner
+        prefix = next((k for k, (x, y) in enumerate(zip(gen, want, strict=False)) if x != y), min(len(gen), len(want)))
+        common = _lcs(gen, want)
+        f1 = 2 * common / (len(gen) + len(want)) if gen or want else 1.0
+        replies.append(
+            {"question": r["question"], "want": want, "gen": gen, "prefix": prefix, "same": gen == want, "lcsF1": f1}
+        )
+    n = len(replies)
+    summary = {
+        "replies": n,
+        "same": sum(x["same"] for x in replies),
+        "mean_prefix": sum(x["prefix"] for x in replies) / n,
+        "mean_ref_len": sum(len(x["want"]) for x in replies) / n,
+        "mean_lcs_f1": sum(x["lcsF1"] for x in replies) / n,
+        "seconds": round(time.time() - t, 1),
+        "pte": str(pte),
+    }
+    (out / f"gen-{args.method}.json").write_text(
+        json.dumps({"summary": summary, "replies": replies}) + "\n", encoding="utf-8"
+    )
+    print(json.dumps(summary, indent=2))
+    return 0
+
