+"""AWQ onto the grid XNNPACK runs, as an experiment beside GPTQ (scripts/awq_compare.py).
+
+Activation-aware weight quantization (Lin et al., arXiv 2306.00978), following AutoAWQ's
+implementation of it, adapted to this delegate the way ``solve.py`` adapts GPTQ: symmetric
+int4 in contiguous groups of 32, bf16 scales, and int8 per-token activations in front of
+every int4 linear. Per layer, on the fp32 model with the scales found so far folded in:
+
+1. Scale search, per group of linears that share an input (AutoAWQ's ``_search_best_scale``
+   with duo scaling): ``s = x_mean^a / w_mean^(1-a)``, normalised by ``sqrt(max * min)``,
+   for ``a`` on a grid of 20, plus ``s = 1`` so the search can never pick worse than plain
+   rounding on its own objective. The objective is the group's output against fp32 with the
+   group's linears at int4 and their inputs int8-rounded: the linears' own outputs for the
+   attention and short-convolution projections, and the whole feed-forward for its gate and
+   up projections (AutoAWQ inspects the MLP there, so the gate x up product is what is
+   protected, which a per-linear solve such as GPTQ cannot see).
+2. Folding: ``1/s`` goes into the producing op (an RMSNorm's weight, or the rows of the
+   linear before), ``s`` into the linear's input columns. Exact in fp32.
+3. Clip search per linear (AutoAWQ's ``_search_best_clip``), except ``wq`` and ``wk``,
+   which AutoAWQ leaves unclipped: per row and group, the clip in 1.0, 0.95, ..., 0.55 whose
+   output error over up to 512 sampled positions is smallest.
+4. Codes: round to nearest at the chosen scale.
+
+The output head gets the clip search only; AutoAWQ does not scale it.
+
+What changes besides the int4 codes is returned as fp32 overrides (the RMSNorm weights), and
+``export_with_codes`` applies them before quantising. ``scale_only`` stops after step 2, for
+GPTQ to solve on the scaled model (the AWQ + GPTQ arm).
+"""
+
+from __future__ import annotations
+
+import time
+
+from pipeline.solve import GROUP, INT4_HALF_RANGE, bf16_storage, fake_act
+
+# The scale search's grid of exponents, as AutoAWQ's n_grid.
+N_GRID = 20
+# AutoAWQ's clip search: max_shrink 0.5 over n_grid 20, so 1.0 down to 0.55.
+CLIPS = tuple(1.0 - i / 20 for i in range(10))
+# Positions the clip search samples, and output rows per batch (AutoAWQ's n_sample_token and
+# oc_batch_size).
+CLIP_TOKENS = 512
+CLIP_ROWS = 64
+# Positions per chunk when a candidate scale is scored, to bound memory.
+CHUNK = 2048
+# Linears AutoAWQ never clips: the attention scores are too sensitive to them.
+NO_CLIP = ("attention.wq", "attention.wk")
+
+
+def _torch():
+    import torch
+
+    return torch
+
+
+def rtn(w, clip: float = 1.0):
+    """Symmetric int4 round to nearest per row and group of 32, at ``clip`` of each group's
+    largest magnitude, with the scale as bf16 stores it: the weight the delegate computes with."""
+    torch = _torch()
+    rows, cols = w.shape
+    g = w.reshape(rows, cols // GROUP, GROUP)
+    scale = bf16_storage(g.abs().amax(-1, keepdim=True).clamp(min=1e-8) * clip / INT4_HALF_RANGE)
+    return (torch.clamp(torch.round(g / scale), -8, 7) * scale).reshape(rows, cols)
+
+
+class Group:
+    """Linears that read one input, the op that produces it, and what the search scores."""
+
+    def __init__(self, name, linears, prev_norm=None, prev_linear=None, ffn=None):
+        self.name = name
+        self.linears = linears  # [(fqn, module)]
+        self.prev_norm = prev_norm  # (fqn, RMSNorm) whose weight takes 1/s
+        self.prev_linear = prev_linear  # (fqn, nn.Linear) whose rows take 1/s
+        self.ffn = ffn  # the FeedForward, when the objective is its whole output
+
+
+def groups(layer, prefix: str) -> list[Group]:
+    """The scaling groups of one decoder layer, in AutoAWQ's order."""
+    from torch import nn
+
+    out: list[Group] = []
+    conv = getattr(layer, "conv", None)
+    attention = getattr(layer, "attention", None)
+    if conv is not None and hasattr(conv, "B_proj"):
+        # LFM2's short convolution: B, C and x read the operator norm; out_proj reads
+        # C * conv(B * x), so its input scale folds into C's rows.
+        out.append(
+            Group(
+                "conv_in",
+                [(f"{prefix}conv.{n}", getattr(conv, n)) for n in ("B_proj", "C_proj", "x_proj")],
+                prev_norm=(f"{prefix}attention_norm", layer.attention_norm),
+            )
+        )
+        out.append(
+            Group(
+                "conv_out",
+                [(f"{prefix}conv.out_proj", conv.out_proj)],
+                prev_linear=(f"{prefix}conv.C_proj", conv.C_proj),
+            )
+        )
+    elif attention is not None and isinstance(getattr(attention, "wq", None), nn.Linear):
+        names = [n for n in ("wq", "wk", "wv") if isinstance(getattr(attention, n, None), nn.Linear)]
+        if names != ["wq", "wk", "wv"]:
+            raise ValueError(f"{prefix}attention: expected wq, wk and wv linears, found {names}")
+        out.append(
+            Group(
+                "qkv",
+                [(f"{prefix}attention.{n}", getattr(attention, n)) for n in names],
+                prev_norm=(f"{prefix}attention_norm", layer.attention_norm),
+            )
+        )
+        wv, wo = attention.wv, attention.wo
+        # Only without grouped-query attention, as AutoAWQ: with fewer value heads than query
+        # heads, wo's input channels are not wv's output channels one to one.
+        if wv.out_features == wo.in_features:
+            out.append(Group("o", [(f"{prefix}attention.wo", wo)], prev_linear=(f"{prefix}attention.wv", wv)))
+    else:
+        raise ValueError(f"{prefix}: neither a short convolution nor an attention block AWQ knows")
+
+    ff = getattr(layer, "feed_forward", None)
+    if ff is None or not all(isinstance(getattr(ff, n, None), nn.Linear) for n in ("w1", "w2", "w3")):
+        raise ValueError(f"{prefix}: no w1/w2/w3 feed-forward")
+    out.append(
+        Group(
+            "gate_up",
+            [(f"{prefix}feed_forward.w1", ff.w1), (f"{prefix}feed_forward.w3", ff.w3)],
+            prev_norm=(f"{prefix}ffn_norm", layer.ffn_norm),
+            ffn=ff,
+        )
+    )
+    out.append(Group("down", [(f"{prefix}feed_forward.w2", ff.w2)], prev_linear=(f"{prefix}feed_forward.w3", ff.w3)))
+    return out
+
+
+def _w_mean(linears):
+    """AutoAWQ's w_mean: each weight relative to its group's largest, averaged per input channel."""
+    torch = _torch()
+    w = torch.cat([m.weight.data for _, m in linears], 0)
+    g = w.reshape(-1, GROUP).abs()
+    g = g / g.amax(1, keepdim=True).clamp(min=1e-8)
+    return g.reshape(w.shape).mean(0)
+
+
+def _score(group: Group, x, s) -> float:
+    """Squared error of the group's output at int4 with input scale ``s``, against fp32."""
+    import torch.nn.functional as F
+
+    total, count = 0.0, 0
+    if group.ffn is not None:
+        ff = group.ffn
+        w1q = rtn(ff.w1.weight.data * s)
+        w3q = rtn(ff.w3.weight.data * s)
+        for c0 in range(0, x.shape[0], CHUNK):
+            xc = x[c0 : c0 + CHUNK]
+            ref = ff.w2(ff.act_fn(F.linear(xc, ff.w1.weight)) * F.linear(xc, ff.w3.weight))
+            xq = fake_act(xc / s)
+            got = ff.w2(ff.act_fn(F.linear(xq, w1q)) * F.linear(xq, w3q))
+            total += float(((got - ref) ** 2).sum())
+            count += ref.numel()
+        return total / count
+    quantised = [(m, rtn(m.weight.data * s)) for _, m in group.linears]
+    for c0 in range(0, x.shape[0], CHUNK):
+        xc = x[c0 : c0 + CHUNK]
+        xq = fake_act(xc / s)
+        for m, wq in quantised:
+            ref = F.linear(xc, m.weight)
+            got = F.linear(xq, wq)
+            if m.bias is not None:
+                ref, got = ref + m.bias, got + m.bias
+            total += float(((got - ref) ** 2).sum())
+            count += ref.numel()
+    return total / count
+
+
+def search_scale(group: Group, x):
+    """The input scale for ``group`` that scores best, and that score against plain rounding's."""
+    torch = _torch()
+    x_mean = x.abs().mean(0)
+    w_mean = _w_mean(group.linears)
+    ones = torch.ones_like(x_mean)
+    best_s, best = ones, _score(group, x, ones)
+    plain = best
+    for i in range(N_GRID):
+        a = i / N_GRID
+        s = (x_mean.pow(a) / w_mean.pow(1 - a).clamp(min=1e-4)).clamp(min=1e-4)
+        s = s / (s.max() * s.min()).sqrt()
+        if not bool(torch.isfinite(s).all()):
+            continue
+        err = _score(group, x, s)
+        if err < best:
+            best_s, best = s, err
+    return best_s, best, plain
+
+
+def fold(group: Group, s) -> None:
+    """Divide the producing op by ``s`` and multiply the linears' input columns by it."""
+    if group.prev_norm is not None:
+        _, norm = group.prev_norm
+        if getattr(norm, "add_unit_offset", False):
+            norm.weight.data = (1.0 + norm.weight.data) / s - 1.0
+        else:
+            norm.weight.data = norm.weight.data / s
+    elif group.prev_linear is not None:
+        _, prev = group.prev_linear
+        prev.weight.data = prev.weight.data / s.unsqueeze(1)
+        if prev.bias is not None:
+            prev.bias.data = prev.bias.data / s
+    else:
+        raise ValueError(f"{group.name}: nothing to fold the scale into")
+    for _, m in group.linears:
+        m.weight.data = m.weight.data * s
+
+
+def clip_codes(w, x, clip_search: bool = True):
+    """int4 codes and scales for ``w``, with each row and group's clip chosen by the error of
+    its partial output over sampled positions of ``x`` (already int8-rounded)."""
+    torch = _torch()
+    rows, cols = w.shape
+    groups_n = cols // GROUP
+    clip = torch.ones(rows, groups_n)
+    if clip_search and x is not None and x.shape[0] > 0:
+        step = max(1, x.shape[0] // CLIP_TOKENS)
+        xs = x[::step][:CLIP_TOKENS].reshape(-1, groups_n, GROUP)  # [T, G, 32]
+        for r0 in range(0, rows, CLIP_ROWS):
+            wb = w[r0 : r0 + CLIP_ROWS].reshape(-1, groups_n, GROUP)  # [B, G, 32]
+            amax = wb.abs().amax(-1, keepdim=True).clamp(min=1e-8)
+            ref = torch.einsum("tgk,bgk->btg", xs, wb)
+            best_err = None
+            best_clip = torch.ones(wb.shape[0], groups_n)
+            for c in CLIPS:
+                scale = bf16_storage(amax * c / INT4_HALF_RANGE)
+                q = torch.clamp(torch.round(wb / scale), -8, 7) * scale
+                err = ((torch.einsum("tgk,bgk->btg", xs, q) - ref) ** 2).mean(1)  # [B, G]
+                if best_err is None:
+                    best_err = err
+                else:
+                    better = err < best_err
+                    best_err = torch.where(better, err, best_err)
+                    best_clip = torch.where(better, torch.full_like(best_clip, c), best_clip)
+            clip[r0 : r0 + CLIP_ROWS] = best_clip
+    g = w.reshape(rows, groups_n, GROUP)
+    amax = g.abs().amax(-1).clamp(min=1e-8)
+    scale = bf16_storage(amax * clip / INT4_HALF_RANGE)  # [rows, G]
+    codes = torch.clamp(torch.round(g / scale.unsqueeze(-1)), -8, 7).to(torch.int8).reshape(rows, cols)
+    return codes, scale.to(torch.float32)
+
+
+def awq_model(model, rows, scale_only: bool = False, log=print) -> tuple[dict, dict, dict]:
+    """AWQ every layer of the eager ``model`` in place; returns (codes, fp32 overrides, stats).
+
+    ``rows`` as ``solve.solve_model`` takes them. With ``scale_only`` no codes are made: the
+    model is left scaled for GPTQ to solve, and only the overrides and stats come back.
+    """
+    torch = _torch()
+    from torch import nn
+
+    class _Stop(Exception):
+        pass
+
+    captured: list = []
+
+    def grab(module, args, kwargs):
+        captured.append((args, kwargs))
+        raise _Stop
+
+    keeps = [keep for _, keep in rows]
+    handle = model.layers[0].register_forward_pre_hook(grab, with_kwargs=True)
+    with torch.no_grad():
+        for ids, _ in rows:
+            try:
+                model(torch.tensor([ids], dtype=torch.long))
+            except _Stop:
+                pass
+    handle.remove()
+    hidden = [call[0][0] for call in captured]
+    row = [0]
+
+    def counted(x):
+        start = keeps[row[0]]
+        return (x[:, start:, :] if x.dim() == 3 else x[start:]).reshape(-1, x.shape[-1])
+
+    codes: dict = {}
+    overrides: dict = {}
+    stats: dict = {"groups": {}}
+    started = time.time()
+    with torch.no_grad():
+        for index, layer in enumerate(model.layers):
+            prefix = f"layers.{index}."
+            layer_groups = groups(layer, prefix)
+            # Inputs of every int4 linear in the layer, from the fp32 layer as it stands.
+            linears = {f"{prefix}{n}": m for n, m in layer.named_modules() if isinstance(m, nn.Linear)}
+            inputs: dict = {name: [] for name in linears}
+            hooks = []
+            for name, module in linears.items():
+
+                def keep_input(mod, args, name=name, store=inputs):
+                    x = counted(args[0])
+                    if x.shape[0]:
+                        store[name].append(x.clone())
+
+                hooks.append(module.register_forward_pre_hook(keep_input))
+            outputs = []
+            for i, (args, kwargs) in enumerate(captured):
+                row[0] = i
+                out = layer(hidden[i], *args[1:], **kwargs)
+                outputs.append(out[0] if isinstance(out, tuple | list) else out)
+            for hook in hooks:
+                hook.remove()
+            x_of = {name: torch.cat(parts, 0) for name, parts in inputs.items() if parts}
+
+            for group in layer_groups:
+                first = group.linears[0][0]
+                x = x_of[first]
+                s, err, plain = search_scale(group, x)
+                fold(group, s)
+                for name, _ in group.linears:
+                    x_of[name] = x_of[name] / s
+                stats["groups"][f"{prefix}{group.name}"] = {"error": err, "plain_error": plain}
+                if group.prev_norm is not None:
+                    fqn, norm = group.prev_norm
+                    overrides[f"{fqn}.weight"] = norm.weight.data.clone()
+
+            if not scale_only:
+                for name, module in linears.items():
+                    x = x_of.get(name)
+                    xq = fake_act(x) if x is not None else None
+                    search = not name.endswith(NO_CLIP)
+                    q, sc = clip_codes(module.weight.data, xq, clip_search=search)
+                    codes[name] = {"qdata": q, "scale": sc}
+            hidden = outputs
+            del x_of, inputs
+            log(f"layer {index} {'scaled' if scale_only else 'quantised'}, {time.time() - started:.0f}s")
+
+        head = getattr(model, "output", None)
+        if not scale_only and isinstance(head, nn.Linear):
+            parts = []
+            for index, state in enumerate(hidden):
+                row[0] = index
+                x = counted(model.norm(state))
+                if x.shape[0]:
+                    parts.append(x)
+            x = fake_act(torch.cat(parts, 0)) if parts else None
+            q, sc = clip_codes(head.weight.data, x)
+            codes["output"] = {"qdata": q, "scale": sc}
+            log(f"output head quantised, {time.time() - started:.0f}s")
+    errs = [g["error"] / g["plain_error"] for g in stats["groups"].values() if g["plain_error"] > 0]
+    stats["mean_error_vs_plain"] = sum(errs) / len(errs) if errs else None
+    return codes, overrides, stats
