@@ -0,0 +1,358 @@
+"""AWQ against GPTQ on the CPU recipe: same model, same calibration rows, same window, same
+file format, only the int4 codes differ. An experiment, not a pipeline stage.
+
+    python scripts/awq_compare.py reference MODEL --revision SHA --heldout heldout.json --out OUT --work WORK
+    python scripts/awq_compare.py arm MODEL --revision SHA --method {rtn,gptq,awq,awq_gptq,published} \\
+        --ref REF_DIR --out OUT --work WORK [--published-file xnnpack/NAME.pte]
+
+``reference`` runs once per model: the calibration rows (the fp32 model's own replies, as
+``pipeline solve`` builds them), the publish gate's fp32 reference, and the fp32 model's
+next-token distributions on held-out prompts. ``arm`` solves one method on those rows
+(timed), exports the 2k window through the pipeline's own exporter (smoke test included),
+and measures the file against the reference: the publish gate, first-token agreement and KL
+on the 141 held-out questions of the phone benchmark under the app's prompt, and teacher-
+forced agreement and KL along the fp32 model's own replies to a third of them.
+
+KL is taken over fp32's 64 most likely tokens plus one bucket for the rest, which bounds
+the full KL from below and keeps the reference small enough to upload to every arm.
+"""
+
+from __future__ import annotations
+
+import argparse
+import gc
+import json
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+TOP = 64
+REPLY_EVERY = 3  # every third held-out question also gets its fp32 reply teacher-forced
+REPLY_TOKENS = 48
+WINDOW = 2048
+PUBLISHED_ORG = "experimentalmachines"
+
+
+def _top(logits):
+    import torch
+
+    logp = torch.log_softmax(logits.float(), -1)
+    vals, idx = torch.topk(logp, TOP)
+    return idx.to(torch.int32), vals.to(torch.float32)
+
+
+def _prompt(tokenizer, question: str) -> str:
+    from pipeline import calibration, gate
+
+    return gate.close_open_think(calibration.render_app(tokenizer, question, thinking=False))
+
+
+def _prepare(model_id: str, revision: str, work: Path):
+    from pipeline import convert, families, hub
+
+    source = hub.fetch(model_id, revision)
+    family = families.family_for(source.config)
+    plan = families.xnnpack_plan(family, source.config)
+    src_dir = work / "source"
+    checkpoint = work / "checkpoint" / "consolidated.pth"
+    hub.download(source, src_dir)
+    convert.convert(src_dir, checkpoint, plan.converter, families.text_config(source.config))
+    return source, plan, src_dir, checkpoint
+
+
+def reference(args) -> int:
+    import torch
+    from transformers import AutoTokenizer
+
+    from pipeline import calibration, gate, solve
+
+    out, work = Path(args.out).resolve(), Path(args.work).resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    work.mkdir(parents=True, exist_ok=True)
+    timings = {}
+    t = time.time()
+    source, plan, src_dir, _ = _prepare(args.model, args.revision, work)
+    timings["download_convert"] = time.time() - t
+    tokenizer = AutoTokenizer.from_pretrained(str(src_dir))
+    fp32, generate = solve.teacher(src_dir, trust_remote_code=plan.lfm3)
+
+    t = time.time()
+    rows = calibration.sequences(generate, tokenizer)
+    timings["calibration"] = time.time() - t
+    torch.save(rows, out / "rows.pt")
+
+    t = time.time()
+    ref = gate.reference(fp32, tokenizer)
+    (out / "gate.json").write_text(json.dumps(ref, indent=2) + "\n", encoding="utf-8")
+    timings["gate_reference"] = time.time() - t
+
+    t = time.time()
+    questions = json.loads(Path(args.heldout).read_text(encoding="utf-8"))
+    if args.limit:
+        questions = questions[: args.limit]
+    heldout, replies = [], []
+    eos = fp32.config.eos_token_id
+    eos = set(eos if isinstance(eos, list | tuple) else [eos])
+    with torch.no_grad():
+        for i, q in enumerate(questions):
+            ids = tokenizer(_prompt(tokenizer, q), add_special_tokens=False)["input_ids"]
+            logits = fp32(torch.tensor([ids])).logits[0, -1]
+            top_ids, top_logp = _top(logits)
+            heldout.append({"question": q, "ids": ids, "top_ids": top_ids, "top_logp": top_logp})
+            if i % REPLY_EVERY == 0:
+                reply = generate(ids, REPLY_TOKENS)
+                cut = next((k + 1 for k, tok in enumerate(reply) if tok in eos), len(reply))
+                reply = reply[:cut]
+                if len(reply) < 2:
+                    continue
+                seq = torch.tensor([ids + reply])
+                full = fp32(seq).logits[0]
+                tops = [_top(full[len(ids) - 1 + k]) for k in range(len(reply))]
+                replies.append(
+                    {
+                        "question": q,
+                        "prompt": ids,
+                        "reply": reply,
+                        "top_ids": torch.stack([a for a, _ in tops]),
+                        "top_logp": torch.stack([b for _, b in tops]),
+                    }
+                )
+    timings["eval_reference"] = time.time() - t
+    torch.save({"heldout": heldout, "replies": replies}, out / "evalref.pt")
+    meta = {
+        "model_id": args.model,
+        "revision": source.sha,
+        "calibration_rows": len(rows),
+        "calibration_positions": sum(len(ids) - keep for ids, keep in rows),
+        "gate_confident_rows": ref["confident"],
+        "heldout_rows": len(heldout),
+        "reply_rows": len(replies),
+        "reply_positions": sum(len(r["reply"]) for r in replies),
+        "timings_s": {k: round(v, 1) for k, v in timings.items()},
+    }
+    (out / "reference.json").write_text(json.dumps(meta, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(meta, indent=2))
+    return 0
+
+
+def _kl(top_ids, top_logp, logq) -> float:
+    """KL(fp32 || export) over fp32's top tokens plus one bucket for everything else."""
+    p = top_logp.double().exp()
+    lq = logq.double()[top_ids.long()]
+    p_tail = (1 - p.sum()).clamp(min=1e-12)
+    q_tail = (1 - lq.exp().sum()).clamp(min=1e-12)
+    return float((p * (top_logp.double() - lq)).sum() + p_tail * (p_tail.log() - q_tail.log()))
+
+
+def _runner(pte: Path, tokenizer_path: Path, vocab: int, scratch: Path):
+    import types
+
+    from executorch.examples.models.llama.runner.native import NativeLlamaRunner
+
+    params = scratch / "params.json"
+    params.write_text(json.dumps({"vocab_size": vocab}))
+    return NativeLlamaRunner(
+        types.SimpleNamespace(
+            pte=str(pte),
+            params=str(params),
+            tokenizer=str(tokenizer_path),
+            tokenizer_config=None,
+            max_len=WINDOW,
+            kv_cache=True,
+        )
+    )
+
+
+def _last(logits):
+    return (logits[0, -1] if logits.dim() == 3 else logits[-1]).float()
+
+
+def evaluate(pte: Path, tokenizer_path: Path, tokenizer, evalref: dict, scratch: Path) -> dict:
+    """The file against fp32 on the held-out prompts and along fp32's replies."""
+    import torch
+
+    vocab = len(tokenizer)
+    rows = []
+    for r in evalref["heldout"]:
+        # A fresh runner per prompt, as the gate does: an LFM2 file carries convolution state.
+        runner = _runner(pte, tokenizer_path, vocab, scratch)
+        logits = _last(runner.forward(torch.tensor([r["ids"]]), torch.tensor([0])))
+        logq = torch.log_softmax(logits, -1)
+        want = int(r["top_ids"][0])
+        rows.append(
+            {
+                "question": r["question"],
+                "fp32_top": want,
+                "top": int(logq.argmax()),
+                "p_fp32_top": float(logq[want].exp()),
+                "fp32_p": float(r["top_logp"][0].exp()),
+                "kl": _kl(r["top_ids"], r["top_logp"], logq),
+            }
+        )
+        del runner
+    replies = []
+    for r in evalref["replies"]:
+        runner = _runner(pte, tokenizer_path, vocab, scratch)
+        prompt, reply = r["prompt"], r["reply"]
+        logits = _last(runner.forward(torch.tensor([prompt]), torch.tensor([0])))
+        per = []
+        for k in range(len(reply)):
+            logq = torch.log_softmax(logits, -1)
+            per.append(
+                {
+                    "agree": int(logq.argmax()) == int(r["top_ids"][k][0]),
+                    "kl": _kl(r["top_ids"][k], r["top_logp"][k], logq),
+                }
+            )
+            if k + 1 < len(reply):
+                logits = _last(runner.forward(torch.tensor([[reply[k]]]), torch.tensor([len(prompt) + k])))
+        replies.append({"question": r["question"], "positions": per})
+        del runner
+    n = len(rows)
+    flat = [p for r in replies for p in r["positions"]]
+    return {
+        "heldout": {
+            "rows": n,
+            "top1_agree": sum(r["top"] == r["fp32_top"] for r in rows) / n,
+            "mean_kl": sum(r["kl"] for r in rows) / n,
+            "mean_p_fp32_top": sum(r["p_fp32_top"] for r in rows) / n,
+        },
+        "replies": {
+            "rows": len(replies),
+            "positions": len(flat),
+            "top1_agree": sum(p["agree"] for p in flat) / max(len(flat), 1),
+            "mean_kl": sum(p["kl"] for p in flat) / max(len(flat), 1),
+        },
+        "per_row": rows,
+        "per_reply": replies,
+    }
+
+
+def arm(args) -> int:
