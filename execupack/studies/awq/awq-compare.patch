+            args.model, args.revision, out / "export", work / "export", context=WINDOW, codes=codes_path
+        )
+        timings["export_and_smoke"] = time.time() - t
+        pte = out / "export" / report["files"][0]["path"] if "files" in report else None
+        if pte is None or not pte.exists():
+            found = sorted((out / "export").rglob("*.pte"))
+            pte = found[0]
+        result["smoke"] = {k: report.get("smoke", {}).get(k) for k in ("passed", "reply", "problems")}
+    result["bytes"] = pte.stat().st_size
+
+    tokenizer_path = src_dir / "tokenizer.json"
+    ref = json.loads((ref_dir / "gate.json").read_text(encoding="utf-8"))
+    t = time.time()
