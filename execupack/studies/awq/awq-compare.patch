+        if args.method == "gptq":
+            codes = solve.solve_model(model, rows)
+        elif args.method == "awq":
+            codes, fp32_overrides, stats = awq.awq_model(model, rows)
+            result["awq"] = {"mean_error_vs_plain": stats["mean_error_vs_plain"]}
+        else:
+            _, fp32_overrides, stats = awq.awq_model(model, rows, scale_only=True)
+            result["awq"] = {"mean_error_vs_plain": stats["mean_error_vs_plain"]}
+            codes = solve.solve_model(model, rows)
