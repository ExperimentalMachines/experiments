+        json.dumps({"per_row": ev["per_row"], "per_reply": ev["per_reply"]}) + "\n", encoding="utf-8"
+    )
+    if not args.keep_pte and args.method != "published":
+        for f in (out / "export").rglob("*.pte"):
+            f.unlink()
+    print(json.dumps({k: v for k, v in result.items()}, indent=2))
