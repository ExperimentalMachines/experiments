From bad27bf9c1844803cf7ea3f236943b0ea0673440 Mon Sep 17 00:00:00 2001
From: Alpha Romer Coma <108984668+alpharomercoma@users.noreply.github.com>
Date: Mon, 21 Sep 2026 23:14:11 +0800
Subject: [PATCH 1/3] publish: isolate LFM 1.2B GPTQ-257 exports

---
 config/pipeline.yaml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/config/pipeline.yaml b/config/pipeline.yaml
index fba4b39..ddce5eb 100644
--- a/config/pipeline.yaml
+++ b/config/pipeline.yaml
@@ -4,7 +4,10 @@
 hub:
   # Where exports are published. One repo per source model: <org>/<source name><suffix>.
   org: experimentalmachines
-  repo_suffix: -ExecuTorch
+  # The app-shaped 257-row GPTQ calibration is a separately benchmarked recipe.
+  # Keep its artifacts and provenance in their own repository; never replace the
+  # generic 104-row exports.
+  repo_suffix: -GPTQ-257-ExecuTorch
   # Tags on every published repo. The app's Discover screen searches filter=executorch.
   tags: [executorch, android, on-device, openweights]
 
